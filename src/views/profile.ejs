<link rel="stylesheet" href="/css/profile.css">

<div class="profile-container">

  <h2>👤 My Profile</h2>

  <% if (!user) { %>

    <div class="profile-card">
      <p>Please login first 🔐</p>
      <a href="/login" class="back-btn">Go to Login</a>
    </div>

  <% } else { %>

    <div class="profile-card">

      <div class="profile-header">
        <div class="avatar">👤</div>
        <h3><%= user.name %></h3>
        <p class="email"><%= user.email %></p>
      </div>

      <div class="profile-details">

        <div class="detail">
          <span>📱 Mobile</span>
          <strong><%= user.mobile %></strong>
        </div>

        <div class="detail">
          <span>⚧ Gender</span>
          <strong><%= user.gender %></strong>
        </div>

        <div class="detail">
          <span>📅 Joined</span>
          <strong><%= new Date(user.createdAt).toDateString() %></strong>
        </div>

      </div>

    </div>

    <a href="/habit/dashboard" class="back-btn">⬅ Back to Dashboard</a>

  <% } %>

</div>
<style>
  body {
  background: #f5f7fb;
  font-family: 'Segoe UI', sans-serif;
}

/* Container */
.profile-container {
  max-width: 500px;
  margin: 40px auto;
}

/* Card */
.profile-card {
  background: white;
  padding: 25px;
  border-radius: 14px;
  box-shadow: 0 6px 20px rgba(0,0,0,0.08);
  text-align: center;
}

/* Header */
.profile-header {
  margin-bottom: 20px;
}

.avatar {
  font-size: 40px;
  margin-bottom: 10px;
}

.profile-header h3 {
  margin: 5px 0;
}

.email {
  color: #666;
  font-size: 14px;
}

/* Details */
.profile-details {
  margin-top: 20px;
  text-align: left;
}

.detail {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid #eee;
}

.detail span {
  color: #666;
}

/* Back button */
.back-btn {
  display: inline-block;
  margin-top: 20px;
  padding: 10px 15px;
  background: #4f46e5;
  color: white;
  border-radius: 8px;
  text-decoration: none;
}

.back-btn:hover {
  background: #4338ca;
}
</style>