

<h2>📊 My Habits</h2>

<!-- ➕ Create Habit -->

<form action="/habit/createHabit" method="POST" class="create-form">
  <input type="text" name="title" placeholder="New Habit" required />
  <input type="text" name="description" placeholder="Description" />
  <button type="submit">Add</button>
</form>

<hr/>

<!-- ❗ Empty state -->

<% if (habits.length === 0) { %>

  <p>No habits yet. Start tracking 🚀</p>
<% } %>

<!-- 🔁 Habit List -->

<% habits.forEach(habit => { %>

  <div class="habit-card">

<!-- 🧠 Left section -->
<div class="habit-info">
  <h3><%= habit.title %></h3>

  <% if (habit.description) { %>
    <p class="desc"><%= habit.description %></p>
  <% } %>

  <% 
    const today = new Date().toISOString().split("T")[0];
    const log = habit.logs.find(l => l.date === today);
  %>

  <% if (log && log.completed) { %>
    <span class="done">✅ Completed Today</span>
  <% } else { %>
    <span class="not-done">❌ Not Done</span>
  <% } %>
</div>

<!-- ⚙️ Actions -->
<div class="actions">

  <!-- Toggle -->
  <form action="/habit/toggle/<%= habit._id %>" method="POST">
    <button>
      <% if (log && log.completed) { %>
        Undo
      <% } else { %>
        Mark Done
      <% } %>
    </button>
  </form>

  <!-- Delete -->
  <form action="/habit/delete/<%= habit._id %>" method="POST"
    onsubmit="return confirm('Delete this habit?')">
    <button class="delete-btn">🗑</button>
  </form>

</div>

  </div>

  <!-- 📅 Logs History -->

  <div class="logs">
    <strong>Last 7 Days:</strong>

<div class="log-list">

  <% 
    const sortedLogs = habit.logs
      .sort((a,b) => new Date(b.date) - new Date(a.date))
      .slice(0,7);
  %>

  <% if (sortedLogs.length === 0) { %>
    <p>No logs yet</p>
  <% } %>

  <% sortedLogs.forEach(log => { %>
    <span class="<%= log.completed ? 'log-done' : 'log-missed' %>">
      <%= log.date %> <%= log.completed ? "✅" : "❌" %>
    </span>
  <% }) %>

</div>

  </div>

<% }) %>

<style>
  body {
  background: #f5f7fb;
  font-family: 'Segoe UI', sans-serif;
}

/* Heading */
h2 {
  margin-bottom: 20px;
}

/* Create form */
.create-form {
  display: flex;
  gap: 10px;
  margin-bottom: 20px;
}

.create-form input {
  padding: 10px;
  border: 1px solid #ddd;
  border-radius: 6px;
  width: 200px;
}

.create-form button {
  background: #4f46e5;
  color: white;
  border: none;
  padding: 10px 15px;
  border-radius: 6px;
  cursor: pointer;
}

.create-form button:hover {
  background: #4338ca;
}

/* Card */
.habit-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  padding: 18px;
  border-radius: 12px;
  margin-bottom: 12px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.05);
}

/* Left info */
.habit-info h3 {
  margin: 0;
}

.desc {
  color: #666;
  font-size: 14px;
  margin: 5px 0;
}

/* Status */
.done {
  color: #16a34a;
  font-weight: 500;
}

.not-done {
  color: #dc2626;
  font-weight: 500;
}

/* Actions */
.actions {
  display: flex;
  gap: 8px;
}

.actions button {
  border: none;
  padding: 6px 12px;
  border-radius: 6px;
  cursor: pointer;
}

.actions form:first-child button {
  background: #2563eb;
  color: white;
}

.actions form:first-child button:hover {
  background: #1d4ed8;
}

.delete-btn {
  background: #ef4444;
  color: white;
}

.delete-btn:hover {
  background: #dc2626;
}

/* Logs */
.logs {
  background: white;
  padding: 12px;
  border-radius: 10px;
  margin-bottom: 20px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.05);
}

.log-list {
  display: flex;
  gap: 6px;
  margin-top: 8px;
  flex-wrap: wrap;
}

.log-done {
  background: #22c55e;
  color: white;
  padding: 5px 8px;
  border-radius: 6px;
  font-size: 12px;
}

.log-missed {
  background: #9ca3af;
  color: white;
  padding: 5px 8px;
  border-radius: 6px;
  font-size: 12px;
}
</style>