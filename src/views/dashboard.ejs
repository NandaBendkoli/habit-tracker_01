
<link rel="stylesheet" href="/css/dashboard.css">
<h2>My Habits</h2>

<!-- ➕ Create Habit -->
<form action="/habit/createHabit" method="POST">
  <input type="text" name="title" placeholder="New Habit" required />
  <input type="text" name="description" placeholder="Description" />
  <button type="submit">Add</button>
</form>

<hr/>

<% habits.forEach(habit => { %>

  <div class="habit-card">
    
    <div>
      <h3><%= habit.title %></h3>

      <% 
        const today = new Date().toISOString().split("T")[0];
        const log = habit.logs.find(l => l.date === today);
      %>

      <% if (log && log.completed) { %>
        <span class="done">✅ Completed Today</span>
      <% } else { %>
        <span class="not-done">❌ Not Done</span>
      <% } %>
    </div>

    <!-- 🔁 Toggle Button -->
    <form action="/habit/toggle/<%= habit._id %>" method="POST">
      <button>
        <% if (log && log.completed) { %>
          Undo
        <% } else { %>
          Mark Done
        <% } %>
      </button>
    </form>

    <form action="/habit/delete/<%= habit._id %>" method="POST"
      onsubmit="return confirm('Are you sure you want to delete this habit?')">
  <button type="submit" class="delete-btn">
    🗑 Delete
  </button>
</form>

  </div>

<% }) %>
